# Browser-side Mapbox public token (pk.*), baked into the bundle at build time.
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# 511.org key for the live tracker. Server-side only, read by api/*.js.
# Set it in the Vercel project env (or export it before `vercel dev`), never in a committed file.
API_KEY_511=
